# Backend runtime environment
# Copy this file to .env and fill the values before running the API.

# Required for Neon-backed persistence.
NEON_CONNECTION_STR=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Optional alternative: set this and let scripts/run_backend.sh resolve
# NEON_CONNECTION_STR dynamically via neonctl.
# NEON_PROJECT_ID=bitter-shadow-03971925

# Feature/runtime flags
USE_TEXT_ANALYSIS=false
INIT_DB_SCHEMA=true

# API bind settings
APP_HOST=127.0.0.1
APP_PORT=8000
