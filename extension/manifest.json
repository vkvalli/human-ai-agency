{
  "manifest_version": 3,
  "name": "Agency Dashboard Extension",
  "description": "On-device agency scoring and drift nudges for AI-assisted writing.",
  "version": "0.1.0",
  "permissions": ["storage", "alarms", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://gemini.google.com/*",
    "*://*.gemini.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Agency Dashboard",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://gemini.google.com/*",
        "*://*.gemini.google.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/storage.js",
        "content/scorer/features.js",
        "content/scorer/heuristic.js",
        "content/scorer/formula.js",
        "content/scorer/intent.js",
        "content/scorer/index.js",
        "content/extractor.js",
        "content/observer.js",
        "content/banner.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "shared/constants.js",
        "content/session_bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
